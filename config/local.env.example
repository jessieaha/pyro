# Copy to config/local.env (gitignored) and fill in for your machine.
# Paths and account names only. Never put passwords, tokens or keys here:
# export those in your shell, a secret manager, or Codespaces / CI secrets.

# Root of this project's working data (events/, raw/, derived/, logs/).
# On Snellius use project space, not /scratch-shared (14-day purge).
PYRO_DATA_ROOT=/projects/0/<project>/<user>/pyro_data

# Read-only model sources (see docs/data_inventory.md).
PPE_SOURCE_ROOT=/projects/0/<project>/<owner>/Pace_PPE_Output
PPE_STACKED_ROOT=/projects/0/<project>/<owner>/Datasets/PPE_Processed_Data/PD
PPE_EXTRACT_ROOT=/scratch-shared/<user>/PPE
AEROCOM_LOCAL_ROOT=/projects/0/<project>/<owner>/Datasets/AeroCom
SPEXONE_EXTRACT_ROOT=/path/to/SPEXone/parquet
ATLID_L3_ROOT=/projects/0/<project>/<owner>/Datasets/EarthCARE

# Slurm (Snellius). Partition for compute steps; transfers use `staging`.
PYRO_SLURM_PARTITION=staging
PYRO_SLURM_ACCOUNT=<account>
PYRO_COMPUTE_PARTITION=rome

# Remote roots used by config/sync.toml.
PYRO_S3_BUCKET=pyro
PYRO_RD_ROOT=pyro
PYRO_GDRIVE_ROOT=pyro
# Path on Snellius, used when syncing *from another machine* via SFTP.
PYRO_SNELLIUS_REMOTE_ROOT=/projects/0/<project>/<user>/pyro_data

# Optional: run pyro-sync inside the container in Slurm jobs.
# PYRO_SYNC_LAUNCHER="apptainer exec --bind /projects,/scratch-shared /path/to/pyro.sif"
