# rclone remotes for config/sync.toml, defined purely by environment variables
# (https://rclone.org/docs/#config-file -> "Environment variables").
#
# This file only lists variable NAMES and non-secret settings. Put secrets in
# your shell session, a password manager, Codespaces/GitHub secrets, or rclone's
# own encrypted config, never in a committed file. Values marked <secret> must be
# provided at runtime. rclone expects *_PASS values in obscured form
# (`rclone obscure`), which is NOT encryption, so handle them as secrets.

# --- SURF Object Store (S3, recommended) -------------------------------------
RCLONE_CONFIG_PYROS3_TYPE=s3
RCLONE_CONFIG_PYROS3_PROVIDER=Ceph
RCLONE_CONFIG_PYROS3_ENDPOINT=https://objectstore.surf.nl
RCLONE_CONFIG_PYROS3_ENV_AUTH=true
# env_auth=true reads the standard S3 variables, which DVC also uses:
# AWS_ACCESS_KEY_ID=<secret>
# AWS_SECRET_ACCESS_KEY=<secret>

# --- SURF Research Drive (WebDAV) --------------------------------------------
RCLONE_CONFIG_PYRORD_TYPE=webdav
# Copy the WebDAV URL from Research Drive -> Settings; format is instance specific.
RCLONE_CONFIG_PYRORD_URL=https://<instance>.data.surfsara.nl/remote.php/webdav/
RCLONE_CONFIG_PYRORD_VENDOR=owncloud
# RCLONE_CONFIG_PYRORD_USER=<research drive username>
# RCLONE_CONFIG_PYRORD_PASS=<secret: obscured app/WebDAV password>

# --- Snellius over SFTP (from laptop / Codespaces / ADA) ---------------------
RCLONE_CONFIG_PYROSNELLIUS_TYPE=sftp
RCLONE_CONFIG_PYROSNELLIUS_HOST=snellius.surf.nl
RCLONE_CONFIG_PYROSNELLIUS_KEY_USE_AGENT=true
# RCLONE_CONFIG_PYROSNELLIUS_USER=<snellius login>

# --- University Google Drive -------------------------------------------------
# OAuth tokens are easiest to create once with `rclone config` (remote name
# `pyrogdrive`); rclone stores them in its own config, outside this repo.
# RCLONE_CONFIG_PYROGDRIVE_TYPE=drive
# RCLONE_CONFIG_PYROGDRIVE_SCOPE=drive.file
# RCLONE_CONFIG_PYROGDRIVE_TOKEN=<secret>

# --- Commercial S3 (optional) ------------------------------------------------
# RCLONE_CONFIG_PYROCS3_TYPE=s3
# RCLONE_CONFIG_PYROCS3_PROVIDER=AWS          # or Cloudflare, Backblaze (B2 S3 API), ...
# RCLONE_CONFIG_PYROCS3_REGION=eu-central-1
# RCLONE_CONFIG_PYROCS3_ENV_AUTH=true

# --- Data-access tokens for step 1 (not used by pyro-sync) -------------------
# NASA Earthdata (earthaccess: PACE, VIIRS, OMPS-LP):
# EARTHDATA_TOKEN=<secret>       or EARTHDATA_USERNAME / EARTHDATA_PASSWORD
# Copernicus ADS (CAMS) and CDS (ERA5), passed to cdsapi.Client(url=..., key=...):
# ADS_API_URL=https://ads.atmosphere.copernicus.eu/api
# ADS_API_KEY=<secret>
# CDS_API_URL=https://cds.climate.copernicus.eu/api
# CDS_API_KEY=<secret>
